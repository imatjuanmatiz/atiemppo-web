---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign seen_urls = "|" -%}
{%- assign documents = site.documents | concat: site.html_pages -%}
{%- for doc in documents -%}
  {%- unless doc.sitemap == false or doc.url contains '/gracias/' or doc.url contains '/confirmado/' or doc.url contains '/404' or doc.url contains '/newsletter/' -%}
    {%- assign path = doc.url | replace: '/index.html', '/' -%}
    {%- assign key = path | prepend: '|' | append: '|' -%}
    {%- unless seen_urls contains key -%}
      <url><loc>{{ path | absolute_url | xml_escape }}</loc>{% if doc.last_modified_at or doc.date %}<lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>{% endif %}</url>
      {%- assign seen_urls = seen_urls | append: key -%}
    {%- endunless -%}
  {%- endunless -%}
{%- endfor -%}
{%- for file in site.static_files -%}
  {%- if file.extname == '.html' or file.extname == '.pdf' -%}
    {%- unless file.sitemap == false or file.path contains '/gracias/' or file.path contains '/confirmado/' or file.path contains '/404' or file.path contains '/newsletter/' -%}
      {%- assign path = file.path | replace: '/index.html', '/' -%}
      {%- assign key = path | prepend: '|' | append: '|' -%}
      {%- unless seen_urls contains key -%}
        <url><loc>{{ path | absolute_url | xml_escape }}</loc></url>
        {%- assign seen_urls = seen_urls | append: key -%}
      {%- endunless -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign text_reports = '/reportes/scorecard-datos-transporte/report.md' | split: ',' -%}
{%- for path in text_reports -%}
  {%- assign key = path | prepend: '|' | append: '|' -%}
  {%- unless seen_urls contains key -%}<url><loc>{{ path | absolute_url | xml_escape }}</loc></url>{%- endunless -%}
{%- endfor -%}
</urlset>
